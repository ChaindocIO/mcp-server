# Required: Chaindoc API key. Get one from your dashboard:
#   Settings → API Access → Create API Key
# Use sk_ for write access, pk_ for read-only.
# (Webhooks + API access require the Business plan.)
CHAINDOC_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: target environment. Keys are environment-agnostic.
# CHAINDOC_ENVIRONMENT=production   # production | staging | development

# Optional: log level. trace | debug | info | warn | error | fatal | silent
# CHAINDOC_LOG_LEVEL=info

# Optional: client-side rate cap (requests/sec).
# Chaindoc allows 10 requests per 60 seconds; default 10/60.
# CHAINDOC_MAX_RPS=0.166

# Optional: SDK request timeout (ms). Default 30000.
# CHAINDOC_TIMEOUT_MS=30000

# Optional: SDK auto-retry tuning for 429 / 5xx / network errors.
# CHAINDOC_RETRY_MAX_RETRIES=3
# CHAINDOC_RETRY_BASE_DELAY_MS=1000
# CHAINDOC_RETRY_MAX_DELAY_MS=10000

# Hosted HTTP transport only:
# PORT=8787
# HOST=0.0.0.0
