{
  "name": "@chaindoc_io/mcp-server",
  "version": "0.2.0",
  "description": "Model Context Protocol server for Chaindoc — blockchain-verified document management, e-signatures, and embedded signing.",
  "license": "MIT",
  "homepage": "https://chaindoc.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChaindocIO/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ChaindocIO/mcp-server/issues"
  },
  "author": "Chaindoc <dev@chaindoc.io> (https://chaindoc.io)",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "bin": {
    "chaindoc-mcp": "dist/transports/stdio.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./stdio": {
      "import": "./dist/transports/stdio.js",
      "types": "./dist/transports/stdio.d.ts"
    },
    "./http": {
      "import": "./dist/transports/http.js",
      "types": "./dist/transports/http.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:stdio": "tsx src/transports/stdio.ts",
    "dev:http": "tsx src/transports/http.ts",
    "start:stdio": "node dist/transports/stdio.js",
    "start:http": "node dist/transports/http.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/transports/stdio.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chaindoc",
    "esignature",
    "blockchain",
    "documents",
    "claude",
    "anthropic"
  ],
  "dependencies": {
    "@chaindoc_io/server-sdk": "^2.1.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "4.22.2",
    "pino": "9.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "9.39.4",
    "tsx": "4.22.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
